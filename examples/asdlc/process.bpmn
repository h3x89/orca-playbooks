<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="AASDLCDefinitions" targetNamespace="https://github.com/h3x89/orca-playbooks/examples/asdlc">
  <bpmn:process id="AASDLCV2" name="Review-gated fix" isExecutable="false">
    <bpmn:documentation>The diagram follows the Orca example YAML. Service tasks run fresh agents, script tasks check evidence or deploy the local copy, and the user task waits for the operator. Revise returns to the plan at most twice. A failed script at any step stops the run, including reproduction and preparation of the plan for review. The diagram details the exits after approval, testing, and deployment.</bpmn:documentation>
    <bpmn:laneSet id="role">
      <bpmn:lane id="lane-agents" name="Agents">
        <bpmn:flowNodeRef>research-code</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>research-rules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan-entry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review-plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review-deploy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-playbooks" name="Playbooks · scripts and coordination">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reproduce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-plan-review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify-plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan-passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stop-plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify-candidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>candidate-passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stop-test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deploy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deploy-passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stop-deploy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verified</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-operator" name="Operator">
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision-result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revision-limit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>flow-1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="fork" name="Start independent steps" gatewayDirection="Diverging">
      <bpmn:incoming>flow-1</bpmn:incoming>
      <bpmn:outgoing>flow-2</bpmn:outgoing>
      <bpmn:outgoing>flow-3</bpmn:outgoing>
      <bpmn:outgoing>flow-4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="research-code" name="Research the code and test">
      <bpmn:incoming>flow-2</bpmn:incoming>
      <bpmn:outgoing>flow-5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="research-rules" name="Research acceptance rules">
      <bpmn:incoming>flow-3</bpmn:incoming>
      <bpmn:outgoing>flow-6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="reproduce" name="Reproduce with the original test">
      <bpmn:incoming>flow-4</bpmn:incoming>
      <bpmn:outgoing>flow-7</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:parallelGateway id="join" name="Wait for three results" gatewayDirection="Converging">
      <bpmn:incoming>flow-5</bpmn:incoming>
      <bpmn:incoming>flow-6</bpmn:incoming>
      <bpmn:incoming>flow-7</bpmn:incoming>
      <bpmn:outgoing>flow-8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="plan-entry" name="Start or revise the plan" gatewayDirection="Converging">
      <bpmn:incoming>flow-8</bpmn:incoming>
      <bpmn:incoming>flow-14</bpmn:incoming>
      <bpmn:outgoing>flow-9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="plan" name="Write a plan from both reports">
      <bpmn:incoming>flow-9</bpmn:incoming>
      <bpmn:outgoing>flow-10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="prepare-plan-review" name="Record the plan version to review">
      <bpmn:incoming>flow-10</bpmn:incoming>
      <bpmn:outgoing>flow-11</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="review-plan" name="Review the plan independently">
      <bpmn:incoming>flow-11</bpmn:incoming>
      <bpmn:outgoing>flow-12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="decide" name="Decide after the plan review">
      <bpmn:incoming>flow-12</bpmn:incoming>
      <bpmn:outgoing>flow-13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="decision-result" name="Operator decision" gatewayDirection="Diverging">
      <bpmn:incoming>flow-13</bpmn:incoming>
      <bpmn:outgoing>flow-14</bpmn:outgoing>
      <bpmn:outgoing>flow-15</bpmn:outgoing>
      <bpmn:outgoing>flow-16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="revision-limit" name="Revision limit reached">
      <bpmn:incoming>flow-16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="verify-plan" name="Check the plan verdict and digest">
      <bpmn:incoming>flow-15</bpmn:incoming>
      <bpmn:outgoing>flow-17</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="plan-passed" name="Plan and repository state valid?" gatewayDirection="Diverging">
      <bpmn:incoming>flow-17</bpmn:incoming>
      <bpmn:outgoing>flow-18</bpmn:outgoing>
      <bpmn:outgoing>flow-19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="stop-plan" name="Stop">
      <bpmn:incoming>flow-19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="fix" name="Apply the approved fix">
      <bpmn:incoming>flow-18</bpmn:incoming>
      <bpmn:outgoing>flow-20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="verify-candidate" name="Rerun the test and record the candidate">
      <bpmn:incoming>flow-20</bpmn:incoming>
      <bpmn:outgoing>flow-21</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="candidate-passed" name="Test and diff valid?" gatewayDirection="Diverging">
      <bpmn:incoming>flow-21</bpmn:incoming>
      <bpmn:outgoing>flow-22</bpmn:outgoing>
      <bpmn:outgoing>flow-23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="stop-test" name="Stop">
      <bpmn:incoming>flow-23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="review-deploy" name="Review the candidate before deployment">
      <bpmn:incoming>flow-22</bpmn:incoming>
      <bpmn:outgoing>flow-24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="deploy" name="Verify the verdict and run the deployed copy">
      <bpmn:incoming>flow-24</bpmn:incoming>
      <bpmn:outgoing>flow-25</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="deploy-passed" name="Did the deployed copy pass its check?" gatewayDirection="Diverging">
      <bpmn:incoming>flow-25</bpmn:incoming>
      <bpmn:outgoing>flow-26</bpmn:outgoing>
      <bpmn:outgoing>flow-27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="stop-deploy" name="Stop">
      <bpmn:incoming>flow-26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="verified" name="Deployment verified">
      <bpmn:incoming>flow-27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow-1" sourceRef="start" targetRef="fork" />
    <bpmn:sequenceFlow id="flow-2" sourceRef="fork" targetRef="research-code" />
    <bpmn:sequenceFlow id="flow-3" sourceRef="fork" targetRef="research-rules" />
    <bpmn:sequenceFlow id="flow-4" sourceRef="fork" targetRef="reproduce" />
    <bpmn:sequenceFlow id="flow-5" sourceRef="research-code" targetRef="join" />
    <bpmn:sequenceFlow id="flow-6" sourceRef="research-rules" targetRef="join" />
    <bpmn:sequenceFlow id="flow-7" sourceRef="reproduce" targetRef="join" />
    <bpmn:sequenceFlow id="flow-8" sourceRef="join" targetRef="plan-entry" />
    <bpmn:sequenceFlow id="flow-9" sourceRef="plan-entry" targetRef="plan" />
    <bpmn:sequenceFlow id="flow-10" sourceRef="plan" targetRef="prepare-plan-review" />
    <bpmn:sequenceFlow id="flow-11" sourceRef="prepare-plan-review" targetRef="review-plan" />
    <bpmn:sequenceFlow id="flow-12" sourceRef="review-plan" targetRef="decide" />
    <bpmn:sequenceFlow id="flow-13" sourceRef="decide" targetRef="decision-result" />
    <bpmn:sequenceFlow id="flow-14" sourceRef="decision-result" targetRef="plan-entry" name="Revise · max 2 loops">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Revise with fewer than two revisions</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-15" sourceRef="decision-result" targetRef="verify-plan" name="OK">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">OK</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-16" sourceRef="decision-result" targetRef="revision-limit" name="Revise at the limit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Revise after two revisions</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-17" sourceRef="verify-plan" targetRef="plan-passed" />
    <bpmn:sequenceFlow id="flow-18" sourceRef="plan-passed" targetRef="fix" name="PASS · matching digest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">PASS with matching plan digest and repository state</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-19" sourceRef="plan-passed" targetRef="stop-plan" name="Failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">BLOCK, missing report, or changed repository state</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-20" sourceRef="fix" targetRef="verify-candidate" />
    <bpmn:sequenceFlow id="flow-21" sourceRef="verify-candidate" targetRef="candidate-passed" />
    <bpmn:sequenceFlow id="flow-22" sourceRef="candidate-passed" targetRef="review-deploy" name="Test and diff passed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The test and diff scope pass</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-23" sourceRef="candidate-passed" targetRef="stop-test" name="Failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The test or diff scope fails</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-24" sourceRef="review-deploy" targetRef="deploy" />
    <bpmn:sequenceFlow id="flow-25" sourceRef="deploy" targetRef="deploy-passed" />
    <bpmn:sequenceFlow id="flow-26" sourceRef="deploy-passed" targetRef="stop-deploy" name="Failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Missing matching PASS, deployment failure, or probe failure</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-27" sourceRef="deploy-passed" targetRef="verified" name="Probe returned 120">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Matching PASS and the deployed copy returns 120</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="AASDLCV2Diagram">
    <bpmndi:BPMNPlane id="AASDLCV2Plane" bpmnElement="AASDLCV2">
